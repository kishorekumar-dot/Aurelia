# Application Settings
DEBUG=False
ENVIRONMENT=development
JWT_SECRET=your_secure_random_jwt_secret_here

# OpenRouter LLM Gateway (Backend Only - NEVER expose to frontend or git)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY_1=your_openrouter_api_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_3_here
OPENROUTER_API_KEY_4=your_openrouter_api_key_4_here

# Model Fallback Sequence
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FALLBACK_MODEL_1=mistralai/mistral-7b-instruct:free
OPENROUTER_FALLBACK_MODEL_2=google/gemma-3-12b-it:free
OPENROUTER_MAX_RETRIES=2

# Tavily Web Search Provider (Backend Only)
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY_1=your_tavily_api_key_1_here
TAVILY_API_KEY_2=your_tavily_api_key_2_here
TAVILY_API_KEY_3=your_tavily_api_key_3_here
TAVILY_MAX_RETRIES=2

# Emergency Fallback LLM (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Common AI
AI_TIMEOUT_SECONDS=60
